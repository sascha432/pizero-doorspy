# doorspy I/O settings (installed to /etc/doorspy/doorspy.env, kept on redeploy).
# Everything here except the GPIO numbers can also be changed in the web UI (Sensors tab).
MQTT_HOST=192.168.0.4
MQTT_PORT=1883

# lights: fade time in seconds when Home Assistant sends no "transition"
DEFAULT_TRANSITION=0.5
# RGB effects (Home Assistant picks the mode, the speed is fixed here): seconds per cycle
RAINBOW_PERIOD=6
PULSE_PERIOD=2
FLASH_PERIOD=1
# RGB as status indicator on top of the idle light: red while the PIR hold is active and
# recording is on (local), yellow for a person and green for a recognised face from Frigate
# (face > person > record; person/face expire INDICATOR_HOLD s after the last event).
# Per indicator: colour (hex), mode (solid, pulse, flash) and seconds per cycle.
RGB_INDICATOR=0
INDICATOR_HOLD=5
RGB_RECORD_COLOR=ff0000
RGB_RECORD_MODE=solid
RGB_RECORD_PERIOD=1
RGB_PERSON_COLOR=ffff00
RGB_PERSON_MODE=solid
RGB_PERSON_PERIOD=1
RGB_FACE_COLOR=00ff00
RGB_FACE_MODE=solid
RGB_FACE_PERIOD=1
# power LED on a PIR trigger: fade to this % and back to the HA state POWER_MOTION_HOLD s later
POWER_ON_MOTION=0
POWER_MOTION_BRIGHTNESS=100
POWER_MOTION_HOLD=30

# button: GPIO26 = J8-37 (active high), long_press after this many seconds
BUTTON_GPIO=26
BUTTON_HOLD=2

# PIR: BCM numbering, GPIO17 = J8-11. The motion sensor (binary_sensor.doorspy_pir) is always on.
PIR_GPIO=17
# motion stays ON this many seconds after the last trigger (retriggers extend it); 0 = raw sensor
PIR_HOLD=60

# Frigate on the Pi 4: the camera itself (Frigate's enable switch: off stops its ffmpeg decoding
# and the stream pull from the Zero - this is what keeps the Pi 4 idle), recording, motion
# detection and person detection (+ face recognition), each "always" on, "pir" (on with motion,
# off HOLD_SECONDS after the last trigger) or "off". Typical: GATE_CAMERA=pir, the rest always.
# Person detection needs motion detection, so GATE_DETECT can't be more on than GATE_MOTION.
# Leave GATE_* at "always" until the SR602 is wired and tested.
GATE_CAMERA=always
GATE_RECORD=always
GATE_MOTION=always
GATE_DETECT=always
# "pir" mode: keep the function on this long after the last PIR trigger
HOLD_SECONDS=120
FRIGATE_CAMERA=doorspy

# CPU temperature to MQTT (doorspy/temperature, Home Assistant sensor) every N seconds
TEMP_INTERVAL=60
