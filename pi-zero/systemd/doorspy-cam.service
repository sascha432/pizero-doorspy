[Unit]
Description=doorspy camera (H.264 to MediaMTX, MJPEG/snapshot on :8080, web UI on :8443)
Requires=mediamtx.service
After=mediamtx.service doorspy-io.service
PartOf=mediamtx.service

[Service]
User=pispy
# video/render: camera and encoders; systemd-journal: log tail in the web UI
SupplementaryGroups=video render systemd-journal
# /var/lib/doorspy: camera.json and web.auth, written by the web UI
StateDirectory=doorspy
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 -u /opt/doorspy/camera.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
